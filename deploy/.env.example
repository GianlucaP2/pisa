# deploy/.env: Pisa under docker compose (deploy/docker-compose.yml). Copy this file to deploy/.env, or let
# `pisa init` write it, and fill it in. Never commit the copy: it holds passwords and keys.
# Every value below is a placeholder. Generate each password with:  openssl rand -hex 24
# The optional Pisa settings (language, money caps, push, voice, models...) are documented in ../.env.example;
# add any of them here.

# --- the way in -----------------------------------------------------------------------------------------------

# Exactly one profile: tailscale (HTTPS on your tailnet; the default way), caddy (a public domain on a VPS) or
# local (the API on your home network with Pisa's own self-signed certificate in deploy/tls/).
COMPOSE_PROFILES=tailscale

# tailscale: an auth key from the Tailscale admin console (used for the first login only), and this node's name
# on the tailnet (Pisa is then https://<name>.<your tailnet>.ts.net).
TS_AUTHKEY=
TS_HOSTNAME=pisa

# caddy: the domain Pisa answers on (its A/AAAA records must point at this machine; ports 80 and 443 must reach
# it), and the contact address for the certificate authority's account (required by this compose file's Caddy).
# Also set PISA_ADDRESSES=https://<the domain> below.
PISA_DOMAIN=pisa.example.com
PISA_ACME_EMAIL=admin@pisa.example.com

# local: where the API is published on this machine. 127.0.0.1 is this machine only; 0.0.0.0 (or this
# machine's LAN address) opens it to the home network. It serves HTTPS with the key and certificate that
# `pisa init --mode local` makes in deploy/tls/ (key.pem 0600, cert.pem); paired clients pin that key.
PISA_LAN_BIND=127.0.0.1
PISA_LAN_PORT=8443
# local: who the API runs as, the owner of deploy/tls/key.pem (`pisa init` writes them; default 10001, the
# image's user).
# PISA_LAN_UID=
# PISA_LAN_GID=
# local, plain http instead of HTTPS (a developer's loopback setup, or your own TLS proxy on the host): set
# both, empty.
# PISA_LAN_TLS_CERT=
# PISA_LAN_TLS_KEY=

# Voice (natural mode's WebRTC audio, UDP): one port per talk from this range; the compose file publishes it
# (caddy: on PISA_VOICE_UDP_BIND, set 0.0.0.0 and open the range in the firewall; local: on PISA_LAN_BIND) or
# relays it from the tailnet (tailscale). PISA_ICE_HOST is where the phone reaches it: tailscale, leave it
# empty (the sidecar writes the node's tailnet IP once it has logged in, and the API reads it at each talk);
# caddy, the domain or public IP; local, this machine's LAN address. Empty there: voice can't connect and the
# app talks over text.
PISA_VOICE_UDP_PORTS=40000-40019
PISA_VOICE_UDP_BIND=127.0.0.1
PISA_ICE_HOST=

# local only (tailscale and caddy set it in the compose file): the proxy whose X-Forwarded-For Pisa believes.
# Empty with nothing in front; 172.29.0.1/32 with a proxy on the host.
PISA_TRUSTED_PROXIES=

# --- you and the server ---------------------------------------------------------------------------------------

# Required. Your home time zone, an IANA name: Europe/London, America/New_York, Asia/Tokyo...
PISA_TIMEZONE=
# The language Pisa speaks and writes by default: en or it.
PISA_LANGUAGE=en
PISA_ENV=prod
PISA_LOG_LEVEL=info
# Required in prod: the key that encrypts provider keys at rest (44 characters):
#   openssl rand -base64 32 | tr '+/' '-_'
PISA_SECRETS_KEY=

# --- the database ---------------------------------------------------------------------------------------------

# The roles' passwords, used when the data volume is first created (deploy/postgres/init). No Pisa process gets
# POSTGRES_PASSWORD. PISA_READONLY_PASSWORD is optional (a read-only login for your own queries).
POSTGRES_PASSWORD=
PISA_MIGRATE_PASSWORD=
PISA_APP_PASSWORD=
PISA_READONLY_PASSWORD=

# --- pairing --------------------------------------------------------------------------------------------------

# How clients reach this server, shown in the pairing QR: comma-separated https:// URLs, at most 6
# (tailscale: https://pisa.<your tailnet>.ts.net; caddy: https://pisa.example.com; local: https://<LAN address>:8443).
PISA_ADDRESSES=
# The certificate clients pin: a file in deploy/tls/, as /etc/pisa/tls/<file>.pem. Empty: QR pairing is off.
# local: /etc/pisa/tls/cert.pem, the certificate `pisa init` makes.
PISA_TLS_CERT=

# --- docker compose -------------------------------------------------------------------------------------------

# The image to run. Empty: built from ../core as pisa:local. A release image is
# ghcr.io/<owner>/pisa@sha256:<digest> (the install scripts take it from the release's IMAGES), <owner> being the
# GitHub account that publishes Pisa; a tag (ghcr.io/<owner>/pisa:<version>) works too, but can be moved.
PISA_IMAGE=
# The compose network: its subnet, its gateway (where a proxy on the host comes from), the range the containers'
# own addresses come from, and the fixed address of the profile's proxy (tailscale or caddy), outside that range:
# the only one PISA_TRUSTED_PROXIES names. Change them together.
PISA_SUBNET=172.29.0.0/24
PISA_GATEWAY=172.29.0.1
PISA_IP_RANGE=172.29.0.128/25
PISA_PROXY_IP=172.29.0.10
