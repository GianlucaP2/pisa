# Pisa's settings, one per line. Local development: copy this file to core/.env and fill it in. Docker compose:
# start from deploy/.env.example (the way in and the settings every install needs) and add any of these to
# deploy/.env. Never commit either copy: they hold passwords.
#
# Generate each password with:  openssl rand -hex 24   (hex: safe inside a database URL)

# --- you ------------------------------------------------------------------------------------------------------

# Required. Your home time zone, an IANA name: Europe/London, America/New_York, Asia/Tokyo...
# While you travel Pisa follows your phone's zone; this is home.
PISA_TIMEZONE=
# The language Pisa speaks and writes by default: en (the default) or it. A turn in the other language is
# answered in that language, and the app's Settings can change it for you.
PISA_LANGUAGE=en
# Optional. Your country, ISO 3166-1 alpha-2 (GB, US, IT...). It is the default region of a phone number written
# without its +prefix, and it switches on the features made for one country (with IT: Italy's public transport
# and weather feeds, radio taxis, certified email, tax calendar...). Empty: none of them.
PISA_COUNTRY=

# --- the server -----------------------------------------------------------------------------------------------

# dev, test or prod. In prod PISA_SECRETS_KEY is required and the API map (/docs) is off.
PISA_ENV=prod
# debug, info, warning or error
PISA_LOG_LEVEL=info
# Where the API listens (docker compose sets these itself).
PISA_API_HOST=127.0.0.1
PISA_API_PORT=8000
# The API serves HTTPS itself with this certificate and key (PEM files' paths); both empty: plain http, for a
# TLS proxy in front. Docker compose's local mode sets them to deploy/tls/ (what `pisa init` makes).
PISA_API_TLS_CERT=
PISA_API_TLS_KEY=
# The reverse proxies whose X-Forwarded-For Pisa believes: a comma-separated list of addresses or CIDRs.
# Empty: the client is always the TCP peer. With docker compose and a proxy on the host: 172.29.0.1/32 (the
# compose network's gateway); with `tailscale serve` or a proxy on the same host without docker:
# 127.0.0.1/32,::1/128. See docs-site/self-hosting.md.
PISA_TRUSTED_PROXIES=
# The key that encrypts provider API keys and tokens at rest (44 characters). Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# (or, with Python's cryptography package: python3 -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())")
# Keep a copy apart from your backups: without it the stored keys can't be read.
PISA_SECRETS_KEY=

# --- the database ---------------------------------------------------------------------------------------------

# docker compose: the passwords of the database's roles, used when the data volume is first created
# (deploy/postgres/init) and to build the URLs below. POSTGRES_PASSWORD is the superuser's: no Pisa process
# gets it. PISA_READONLY_PASSWORD is optional (a read-only login for your own queries).
POSTGRES_PASSWORD=
PISA_MIGRATE_PASSWORD=
PISA_APP_PASSWORD=
PISA_READONLY_PASSWORD=
# Local development only (docker compose builds these from the passwords above): the app's role (read/write,
# no DDL), the migration role (DDL, `pisa migrate`) and the worker's DBOS database. These point at the README's
# throwaway development Postgres.
PISA_DATABASE_URL=postgresql://postgres:dev@127.0.0.1:55432/pisa
PISA_MIGRATE_DATABASE_URL=postgresql://postgres:dev@127.0.0.1:55432/pisa
PISA_DBOS_DATABASE_URL=postgresql://postgres:dev@127.0.0.1:55432/pisa_dbos

# --- docker compose -------------------------------------------------------------------------------------------

# The way in, the image and the network: see deploy/.env.example, which lists them (COMPOSE_PROFILES,
# TS_AUTHKEY, PISA_DOMAIN, PISA_LAN_BIND, PISA_LAN_PORT, PISA_IMAGE, PISA_SUBNET...).

# --- money ----------------------------------------------------------------------------------------------------

# The hard spending limit over every paid service together (AI, voice, maps, web), in euros. The caps you set
# in the app can only be lower.
PISA_HARD_DAILY_EUR=3
PISA_HARD_MONTHLY_EUR=30

# --- push (optional) ------------------------------------------------------------------------------------------

# APNs, for pushes to the iPhone app (and the Apple Maps key, signed with the same team): your Apple Developer
# team id and the app's bundle id. Then store the .p8 key with `pisa secrets set-apns`. Empty: push is off
# (/readyz says "push": "off") and everything else works.
PISA_APNS_TEAM_ID=
PISA_APNS_TOPIC=
# The push relay for the App Store app: notices are sealed to the phone's key, so the relay sees no text. Its
# https origin, e.g. https://relay.example.net. Empty: relay mode is off (/readyz says "relay": "off").
PISA_PUSH_RELAY_URL=

# --- pairing --------------------------------------------------------------------------------------------------

# How clients reach this server, shown in the pairing QR (`pisa pair`): comma-separated https:// URLs (home
# network, IPv6, IPv4, your own domain) and relay://<host>/<handle> blind relays, at most 6.
PISA_ADDRESSES=
# The TLS certificate clients pin (PEM: the certificate or its public key) and, before a rotation, the next
# key (PEM), announced to paired clients ahead of its use. Each is a file's path (docker compose: put the file
# in deploy/tls/ and write /etc/pisa/tls/<file>.pem) or the PEM itself, on one line with \n for its line
# breaks. Without PISA_TLS_CERT (or PISA_TLS_PIN_FROM below), QR pairing is off.
PISA_TLS_CERT=
# Without PISA_TLS_CERT: pin the certificate the TLS proxy at this host:port presents for the first https://
# address, once it passes WebPKI verification (docker compose's caddy mode: caddy:443).
PISA_TLS_PIN_FROM=
PISA_TLS_NEXT_KEY=
# A developer's machine only: pair and talk over plain http with no certificate. Refused unless PISA_TLS_CERT is
# empty and every PISA_ADDRESSES entry is http on loopback (http://127.0.0.1:8000); the API then answers only
# this machine. Never for a phone, and never behind a proxy or tunnel (it would let other machines in).
PISA_INSECURE_LOOPBACK_PAIRING=false
# With it, in docker compose: also answer the compose network's gateway, where the host's own loopback
# connections arrive under rootful Docker on Linux with the port published on 127.0.0.1 only (the shipped
# compose file). Not under Docker Desktop, rootless Docker or Podman: there other machines can arrive from the
# gateway too. Off: only `docker compose exec api pisa client ...` reaches the API.
PISA_INSECURE_LOOPBACK_GATEWAY=false

# --- models and providers -------------------------------------------------------------------------------------

# No feature has a default model: choose one per slot in the app (Settings > AI models) or on the server with
# `pisa models list`, `pisa models available` and `pisa models set <slot> <provider:model>`.
# An Ollama server's root (http://127.0.0.1:11434). Empty: no Ollama provider.
PISA_OLLAMA_BASE_URL=
# A JSON file laid over the shipped model catalog (core/pisa/domain/model_catalog.json): per-model reasoning
# effort and the voice connectors' default models, per provider. Empty: the shipped catalog.
PISA_MODEL_CATALOG=

# --- voice ----------------------------------------------------------------------------------------------------

# The WebRTC ICE servers for voice talks, a JSON list as browsers take it:
#   [{"urls": ["turn:turn.example.com:3478"], "username": "...", "credential": "..."}]
# []: host candidates only (the phone must reach the server directly, e.g. over a VPN).
PISA_TALK_ICE_SERVERS=[]
# The talk's media on a fixed UDP port range (one port per talk), and the address the phone reaches it at,
# offered as its ICE host candidate (an IP or a name). Empty range: any free port; empty host: each interface's
# own address (fine on the same network, never from a container). deploy/.env.example has each mode's values.
PISA_VOICE_UDP_PORTS=
PISA_ICE_HOST=
# A talk whose media hasn't connected this many seconds after Pisa's answer ends (voice unavailable; the app
# carries on over its live socket).
PISA_VOICE_CONNECT_TIMEOUT_S=15
# The user-voice gate: on (the default) answers only the user's voice once it is enrolled; off answers anyone.
PISA_VOICE_GATE=true
# Where the gate's speaker models are (the image fetches them at build time) and which embedder it uses.
PISA_VOICE_MODELS_DIR=/app/models/voice
PISA_VOICE_EMBEDDER=resnet34

# --- the web --------------------------------------------------------------------------------------------------

# Pisa's own public https origin (https://pisa.example.com, nothing after it), where its agent card and its
# signing keys are published. Empty: Pisa signs nothing.
PISA_AGENT_URL=
# A contact address Unpaywall asks every caller for (to find open copies of papers). Empty: Unpaywall is skipped.
PISA_LEARN_CONTACT_EMAIL=
# Drawings in a sealed box on the phone: on only once your app version supports it.
PISA_DRAWING_BOX=
