            "properties": {
              "id": {
                "type": "string",
                "pattern": "^o[1-5]$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      },
      "required": [
        "component",
        "question",
        "options"
      ]
