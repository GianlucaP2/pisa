            "call",
            "message",
            "map"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^(https://\\S+|tel:\\+[1-9][0-9]{5,14}|sms:(\\+[1-9][0-9]{5,14})?&body=[A-Za-z0-9%._~-]*)$"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{5,14}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "notes": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "fallback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Plain text said or shown where this component cannot be drawn (unknown component, glasses, watch, VoiceOver summary). Required."
        }
      },
      "required": [
        "component",
        "handoffId",
        "kind",
        "title",
        "fallback"
      ]
    },
    "WeatherSummary": {
      "type": "object",
      "description": "The forecast for one place and one day, as the turn's get_weather read it: the current hour (today only), the day's low, high and rain chance, and up to 24 hours. Temperatures in degrees Celsius, chances in percent; times are RFC 3339 with the place's UTC offset.",
      "x-pisa-fallback": "fallback",
      "properties": {
        "component": {
          "const": "WeatherSummary"
        },
        "place": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The forecast's day (YYYY-MM-DD)."
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "The condition in words, in the surface's language (\"Light rain\", \"Pioggia debole\")."
        },
        "now": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tempC",
            "condition"
          ],
          "description": "The current hour's forecast; absent for another day.",
          "properties": {
            "tempC": {
              "type": "number",
              "minimum": -100,
              "maximum": 70,
              "description": "Degrees Celsius."
            },
            "condition": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "The condition in words, in the surface's language (\"Light rain\", \"Pioggia debole\")."
            }
          }
        },
        "minC": {
          "type": "number",
          "minimum": -100,
          "maximum": 70,
          "description": "Degrees Celsius."
        },
        "maxC": {
          "type": "number",
          "minimum": -100,
          "maximum": 70,
          "description": "Degrees Celsius."
        },
        "rainChance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Chance of precipitation, percent."
        },
        "hourly": {
          "type": "array",
          "maxItems": 24,
          "description": "In time order: today the next 24 hours from the current one, another day its hours.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time",
              "tempC",
              "rainChance",
              "condition"
            ],
            "properties": {
              "time": {
                "type": "string",
                "format": "date-time",
                "maxLength": 40
              },
              "tempC": {
                "type": "number",
                "minimum": -100,
                "maximum": 70,
                "description": "Degrees Celsius."
              },
              "rainChance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Chance of precipitation, percent."
              },
              "condition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "The condition in words, in the surface's language (\"Light rain\", \"Pioggia debole\")."
              }
            }
          }
        },
        "fallback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Plain text said or shown where this component cannot be drawn (unknown component, glasses, watch, VoiceOver summary). Required."
        }
      },
      "required": [
        "component",
        "place",
        "date",
        "condition",
        "minC",
        "maxC",
        "rainChance",
        "hourly",
        "fallback"
      ]
    }
