    "Handoff": {
      "type": "object",
      "description": "The app hands a prepared act to the system (open a page, call, message, map) after the user's tap.",
      "x-pisa-fallback": "fallback",
      "properties": {
        "component": {
          "const": "Handoff"
        },
        "handoffId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "type": "string",
          "enum": [
