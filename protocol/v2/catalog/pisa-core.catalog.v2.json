    "Ref": {
      "type": "object",
      "description": "Something the server holds (plan, place, task, event, email, draft, approval, claim, thing, changes, setting): Ring 0 draws it from REST, so the object is the truth, not a copy.",
      "x-pisa-fallback": "fallback",
      "properties": {
        "component": {
          "const": "Ref"
        },
        "ref": {
          "type": "string",
          "pattern": "^(plan:\\d{4}-\\d{2}-\\d{2}|place:[0-9a-f-]{36}|(task|event|email|draft|approval|claim|thing):\\S{1,1100}|changes:(all|\\S{1,40})|setting:[a-z_]{1,40})$"
        },
        "detail": {
          "type": "string",
          "enum": [
            "card",
            "full"
          ],
          "default": "card"
        },
        "fallback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "Plain text said or shown where this component cannot be drawn (unknown component, glasses, watch, VoiceOver summary). Required."
