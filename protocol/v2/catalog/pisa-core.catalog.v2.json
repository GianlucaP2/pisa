    "Choice": {
      "type": "object",
      "description": "A question answerable by tap or voice; a tap sends action pisa.choose with optionId.",
      "x-pisa-fallback": "question, then '1. label' lines",
      "properties": {
        "component": {
          "const": "Choice"
