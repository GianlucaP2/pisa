      },
      "required": [
        "component",
        "ref",
        "fallback"
      ]
    },
    "Button": {
      "type": "object",
      "description": "A tap. Never an approval: approvals are Ring 0 (interrupts). Action names are the closed list pisa.*.",
      "x-pisa-fallback": "label",
